APP_ENV=development          # development|staging|production
APP_NAME=template-golang

LOG_LEVEL=info               # debug|info|warn|error
LOG_FORMAT=auto              # auto|json|text (auto: text in dev, json in prod)
ERROR_TRACE_ENABLED=true     # add trace (file.go:line) to errors
ERROR_STACKTRACE_ENABLED=false  # full stack for 5xx/PANIC (staging)

HTTP_HOST=0.0.0.0
HTTP_PORT=3001
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=1
DB_AUTO_MIGRATE=true

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=dev-secret-change-me   # required; must not be default in production
JWT_TTL=24h
COOKIE_NAME=access_token
COOKIE_DOMAIN=
COOKIE_SECURE=false

CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com

FEATURE_OPENAPI_ENABLED=true  # /docs + /openapi.json (Scalar UI)
FEATURE_PPROF_ENABLED=false
